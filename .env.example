# Copie los datos de Connect > Django / Session pooler en Supabase.
DB_HOST=aws-0-REGION.pooler.supabase.com
DB_NAME=postgres
DB_USER=postgres.PROJECT_REF
DB_PASSWORD=CAMBIAR_POR_LA_CLAVE_DE_LA_BASE_DE_DATOS
DB_PORT=5432
DB_SSLMODE=require

# Desarrollo local: una clave estable conserva las sesiones entre reinicios.
SECRET_KEY=CAMBIAR_POR_UNA_CLAVE_ALEATORIA_LARGA
DEBUG=true
# En Render: DEBUG=false y SECRET_KEY generada desde el panel.
# El dominio de Render se permite automaticamente. Para un dominio propio:
# ALLOWED_HOSTS=constructora.ejemplo.cl
# CSRF_TRUSTED_ORIGINS=https://constructora.ejemplo.cl
