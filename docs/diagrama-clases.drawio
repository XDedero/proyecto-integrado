        <mxCell id="auth-nota" value="Las asociaciones M:N de User.groups, User.user_permissions y Group.permissions se detallan mediante sus tablas intermedias reales.&lt;br&gt;Session guarda la sesión codificada; no tiene FK a User.&lt;br&gt;LogEntry registra acciones del administrador de Django; no es una bitácora de todos los pagos de la aplicación.&lt;br&gt;User en esta página es la misma clase del modelo de dominio." style="shape=note;whiteSpace=wrap;html=1;align=left;spacing=12;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="1480" y="1200" width="450" height="190" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
